.editor-page{background:#171615;min-height:100vh;padding:24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom))}
.editor-preview{align-items:center;background:#282421;border-radius:24rpx;display:flex;height:50vh;justify-content:center;overflow:hidden;position:relative}
.crop-frame{background:#000;border-radius:10rpx;box-shadow:0 0 0 2rpx rgba(255,255,255,.32);overflow:hidden;position:relative}
.crop-image-box{position:absolute}
.crop-image{left:50%;max-height:none;max-width:none;position:absolute;top:50%;transform-origin:center center}
.filter-layer{bottom:0;left:0;position:absolute;right:0;top:0}
.crop-grid{bottom:0;left:0;position:absolute;right:0;top:0}
.crop-grid-v,.crop-grid-h{background:rgba(255,255,255,.26);position:absolute}
.crop-grid-v{height:100%;top:0;width:1rpx}
.crop-grid-v1{left:33.333%}
.crop-grid-v2{left:66.666%}
.crop-grid-h{height:1rpx;left:0;width:100%}
.crop-grid-h1{top:33.333%}
.crop-grid-h2{top:66.666%}
.preview-loading{color:#cfc6bc;font-size:24rpx;position:absolute}
.compare-badge{background:rgba(0,0,0,.7);border-radius:999rpx;color:#fff;font-size:22rpx;left:20rpx;padding:9rpx 16rpx;position:absolute;top:20rpx}
.editor-hint{color:#a69d95;font-size:23rpx;line-height:1.6;margin-top:20rpx}
.editor-section{margin-top:26rpx}
.editor-section-title{color:#fff;font-size:28rpx;font-weight:700;margin-bottom:14rpx}
.choice-scroll{white-space:nowrap;width:100%}
.choice-row{display:inline-flex;gap:14rpx}
.choice-pill{background:#39332e;border:1rpx solid #5a514a;border-radius:999rpx;color:#cfc6bc;font-size:24rpx;padding:13rpx 22rpx}
.choice-active{background:#fff;border-color:#fff;color:#222}
.tool-row{display:flex;gap:14rpx}
.tool-row + .tool-row{margin-top:14rpx}
.editor-tool{background:#39332e;border:1rpx solid #4b433d;border-radius:16rpx;color:#fff;flex:1;font-size:23rpx;height:64rpx;line-height:64rpx;margin:0;padding:0 10rpx}
.tool-disabled{color:#7a7068;opacity:.55}
.tool-note{color:#8d837a;flex:0 0 auto;font-size:21rpx;line-height:64rpx;padding-left:6rpx}
.preset-row{align-items:center;display:flex;gap:16rpx;margin-bottom:16rpx}
.preset-button{background:#4b3f35;border:1rpx solid #6d5b4c;border-radius:999rpx;color:#f5dcc1;font-size:23rpx;line-height:56rpx;margin:0;padding:0 24rpx}
.preset-note{color:#a69d95;font-size:22rpx}
.filter-level{margin-top:18rpx}
.filter-level-head{color:#a69d95;display:flex;font-size:22rpx;justify-content:space-between;margin-bottom:4rpx;padding:0 4rpx}
.filter-slider{margin:0 6rpx}
.crop-tools{margin-top:26rpx}
.crop-tool-row{align-items:center;display:flex;gap:16rpx;justify-content:space-between}
.crop-tool-row text{color:#a69d95;font-size:22rpx}
.crop-tool{background:#39332e;border-radius:999rpx;color:#fff;font-size:22rpx;height:58rpx;line-height:58rpx;margin:0;padding:0 20rpx}
.editor-actions{display:flex;gap:18rpx;margin-top:28rpx}
.editor-actions button{flex:1}
.editor-canvas{height:1px;left:-9999px;opacity:0;position:fixed;top:0;width:1px}
.editor-error{align-items:center;background:#7d3f3a;bottom:0;color:#fff;display:flex;font-size:23rpx;left:0;line-height:1.45;padding:18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));position:fixed;right:0;z-index:10}
.editor-error-text{flex:1}
.editor-error-close{flex:0 0 auto;font-size:34rpx;line-height:1;padding:10rpx 4rpx 10rpx 24rpx}
