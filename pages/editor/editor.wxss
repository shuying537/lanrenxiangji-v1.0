.editor-page{background:#171615;min-height:100vh;padding:28rpx 30rpx 50rpx}.editor-preview{align-items:center;background:#282421;border-radius:24rpx;display:flex;height:62vh;justify-content:center;overflow:hidden;position:relative}.editor-image{height:100%;width:100%}.compare-badge{background:rgba(0,0,0,.65);border-radius:999rpx;color:#fff;font-size:22rpx;left:24rpx;padding:9rpx 15rpx;position:absolute;top:24rpx}.editor-section{margin-top:30rpx}.editor-section-title{color:#fff;font-size:29rpx;font-weight:700;margin-bottom:14rpx}.choice-scroll{white-space:nowrap;width:100%}.choice-row{display:inline-flex;gap:14rpx}.choice-pill{background:#39332e;border:1rpx solid #5a514a;border-radius:999rpx;color:#cfc6bc;font-size:24rpx;padding:13rpx 22rpx}.choice-active{background:#fff;border-color:#fff;color:#222}.editor-hint{color:#a69d95;font-size:23rpx;line-height:1.5;margin-top:30rpx}.editor-actions{display:flex;gap:18rpx;margin-top:25rpx}.editor-actions button{flex:1}.editor-canvas{height:1px;opacity:0;position:fixed;width:1px}.editor-error{background:#7d3f3a;bottom:0;color:#fff;font-size:23rpx;left:0;line-height:1.45;padding:18rpx 28rpx;position:fixed;right:0}
