.profile-card{align-items:center;background:#2b2926;border-radius:24rpx;color:#fff;display:flex;gap:20rpx;margin-top:30rpx;padding:26rpx}.profile-icon{align-items:center;background:#e1c6a6;border-radius:18rpx;color:#3d332a;display:flex;font-size:23rpx;font-weight:700;height:76rpx;justify-content:center;width:76rpx}.profile-title{font-size:29rpx;font-weight:700}.profile-note{color:#b9afa5;font-size:23rpx;line-height:1.5;margin-top:8rpx}.small-title{font-size:32rpx;margin-top:48rpx}.simple-list{margin-top:18rpx}.simple-item,.empty-card,.privacy-card{background:#fff;border-radius:16rpx;margin-top:12rpx;padding:24rpx}.simple-item{display:flex;font-size:26rpx;justify-content:space-between}.empty-card{color:#9a8e81;font-size:25rpx;line-height:1.5}.recent-title{margin-top:44rpx}.privacy-card{margin-top:48rpx}.clear-button{margin-top:26rpx;width:100%}
