.hero {
  padding: 12rpx 0 40rpx;
}

.brand-row {
  align-items: center;
  display: flex;
  gap: 16rpx;
}

.brand-mark {
  align-items: center;
  background: #222;
  border-radius: 18rpx;
  color: #fff;
  display: flex;
  font-size: 24rpx;
  font-weight: 700;
  height: 58rpx;
  justify-content: center;
  width: 58rpx;
}

.brand-name {
  font-size: 29rpx;
  font-weight: 700;
}

.hero-title {
  font-size: 54rpx;
  font-weight: 700;
  line-height: 1.2;
  margin-top: 42rpx;
  max-width: 620rpx;
}

.hero-note {
  color: #8b8175;
  font-size: 27rpx;
  margin-top: 18rpx;
}

.album-entry {
  background: #fff;
  border: 1rpx solid #ded7ce;
  border-radius: 999rpx;
  color: #554b41;
  font-size: 24rpx;
  height: 68rpx;
  line-height: 66rpx;
  margin: 22rpx 0 0;
  width: 230rpx;
}

.featured-card {
  background: #2b2926;
  border-radius: 30rpx;
  color: #fff;
  display: flex;
  justify-content: space-between;
  min-height: 290rpx;
  overflow: hidden;
  padding: 30rpx;
}

.featured-copy {
  display: flex;
  flex-direction: column;
  max-width: 54%;
}

.eyebrow {
  color: #c9bbaa;
  font-size: 22rpx;
}

.featured-title {
  font-size: 37rpx;
  font-weight: 700;
  line-height: 1.35;
  margin-top: 25rpx;
}

.featured-desc {
  color: #c9c1b7;
  font-size: 23rpx;
  line-height: 1.5;
  margin-top: 16rpx;
}

.featured-link {
  color: #fff;
  font-size: 24rpx;
  margin-top: auto;
}

.featured-preview {
  border-radius: 22rpx;
  height: 230rpx;
  margin: auto 0;
  width: 210rpx;
}

.preview-image {
  height: 100%;
  left: 0;
  position: absolute;
  top: 0;
  width: 100%;
}

.section-head {
  margin: 48rpx 0 22rpx;
}

.category-scroll {
  white-space: nowrap;
  width: 100%;
}

.category-row {
  display: inline-flex;
  gap: 16rpx;
  padding-bottom: 6rpx;
}

.category-pill {
  background: #fff;
  border: 1rpx solid #e9e1d7;
  border-radius: 999rpx;
  color: #8b8175;
  display: inline-block;
  font-size: 24rpx;
  padding: 15rpx 25rpx;
}

.category-active {
  background: #222;
  border-color: #222;
  color: #fff;
}

.template-grid {
  display: grid;
  gap: 22rpx;
  grid-template-columns: repeat(2, 1fr);
  margin-top: 28rpx;
}

.template-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.template-meta {
  padding: 20rpx;
}

.template-title {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}

.template-tags {
  color: #9a8e81;
  display: flex;
  font-size: 21rpx;
  gap: 16rpx;
  margin-top: 11rpx;
}

.recent-section {
  margin-top: 50rpx;
}

.small-title {
  font-size: 32rpx;
}

.recent-item {
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  display: flex;
  font-size: 25rpx;
  margin-top: 12rpx;
  padding: 22rpx;
}

.recent-dot {
  background: #d3a778;
  border-radius: 50%;
  height: 14rpx;
  margin-right: 16rpx;
  width: 14rpx;
}

.recent-arrow {
  color: #9a8e81;
  font-size: 35rpx;
  margin-left: auto;
}
