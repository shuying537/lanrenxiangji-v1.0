.camera-page {
  background: #171615;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.camera-missing {
  color: #cfc6bc;
  font-size: 28rpx;
  padding: 120rpx 40rpx;
  text-align: center;
}

.camera-stage {
  align-self: center;
  background: #000;
  flex: 0 0 auto;
  margin-top: 12rpx;
  overflow: hidden;
  position: relative;
}

.camera {
  display: block;
  height: 100%;
  width: 100%;
}

.guide-overlay {
  height: 100%;
  position: relative;
  width: 100%;
}

.guide-safe-area {
  border: 2rpx solid rgba(255, 255, 255, .62);
  border-radius: 16rpx;
  height: 70%;
  left: 10%;
  position: absolute;
  top: 18%;
  width: 80%;
}

.guide-grid {
  height: 70%;
  left: 10%;
  position: absolute;
  top: 18%;
  width: 80%;
}

.guide-grid-v,
.guide-grid-h {
  background: rgba(255, 255, 255, .26);
  position: absolute;
}

.guide-grid-v {
  height: 100%;
  top: 0;
  width: 1rpx;
}

.guide-grid-v1 {
  left: 33.333%;
}

.guide-grid-v2 {
  left: 66.666%;
}

.guide-grid-h {
  height: 1rpx;
  left: 0;
  width: 100%;
}

.guide-grid-h1 {
  top: 33.333%;
}

.guide-grid-h2 {
  top: 66.666%;
}

.guide-caption {
  background: rgba(0, 0, 0, .5);
  border-radius: 999rpx;
  color: #fff;
  font-size: 22rpx;
  left: 50%;
  max-width: 84%;
  padding: 10rpx 20rpx;
  position: absolute;
  top: 104rpx;
  transform: translateX(-50%);
  white-space: nowrap;
  z-index: 2;
}

.guide-person {
  background: rgba(255, 255, 255, .07);
  border: 3rpx dashed rgba(255, 255, 255, .9);
  border-radius: 50% 50% 18% 18%;
  box-sizing: border-box;
  height: 37%;
  position: absolute;
  width: 24%;
}

.guide-object {
  background: rgba(255, 214, 106, .1);
  border: 3rpx dashed rgba(255, 214, 106, .95);
  border-radius: 12rpx;
  box-sizing: border-box;
  height: 27%;
  position: absolute;
  width: 30%;
}

.person-left-bottom {
  bottom: 10%;
  left: 14%;
}

.person-right-bottom {
  bottom: 10%;
  right: 14%;
}

.person-right-middle {
  right: 13%;
  top: 29%;
}

.person-left-middle {
  left: 13%;
  top: 29%;
}

.person-left-wide {
  bottom: 22%;
  height: 34%;
  left: 9%;
  width: 23%;
}

.person-right-wide {
  bottom: 22%;
  height: 34%;
  right: 9%;
  width: 23%;
}

.person-front-center {
  bottom: 12%;
  height: 42%;
  left: 37%;
  width: 26%;
}

.person-back-center {
  height: 27%;
  left: 43%;
  top: 28%;
  width: 18%;
}

.person-couple-wide {
  bottom: 22%;
  height: 34%;
  left: 38%;
  width: 24%;
}

.object-right-top {
  right: 10%;
  top: 22%;
}

.object-left-top {
  left: 10%;
  top: 22%;
}

.object-line-bottom {
  bottom: 17%;
  height: 24%;
  left: 10%;
  width: 42%;
}

.object-edge-left {
  height: 48%;
  left: 7%;
  top: 22%;
  width: 22%;
}

.object-edge-right {
  height: 48%;
  right: 7%;
  top: 22%;
  width: 22%;
}

.object-window-right {
  height: 48%;
  right: 7%;
  top: 20%;
  width: 31%;
}

.object-window-left {
  height: 48%;
  left: 7%;
  top: 20%;
  width: 31%;
}

.object-table-bottom {
  bottom: 9%;
  height: 23%;
  left: 28%;
  width: 48%;
}

.object-center {
  height: 20%;
  left: 35%;
  top: 42%;
  width: 30%;
}

.guide-label {
  background: rgba(0, 0, 0, .68);
  border-radius: 999rpx;
  color: #fff;
  font-size: 20rpx;
  height: auto;
  line-height: 1.3;
  padding: 8rpx 14rpx;
  position: absolute;
  white-space: nowrap;
  width: auto;
  z-index: 3;
}

.guide-label.object-label {
  color: #ffe18a;
}

.guide-label.person-left-bottom {
  bottom: 5%;
  left: 9%;
}

.guide-label.person-right-bottom {
  bottom: 5%;
  right: 9%;
}

.guide-label.person-right-middle {
  right: 5%;
  top: 25%;
}

.guide-label.person-left-middle {
  left: 5%;
  top: 25%;
}

.guide-label.person-left-wide {
  bottom: 16%;
  left: 4%;
}

.guide-label.person-right-wide {
  bottom: 16%;
  right: 4%;
}

.guide-label.person-front-center {
  bottom: 5%;
  left: 50%;
  transform: translateX(-50%);
}

.guide-label.person-back-center {
  left: 50%;
  top: 22%;
  transform: translateX(-50%);
}

.guide-label.person-couple-wide {
  bottom: 16%;
  left: 50%;
  transform: translateX(-50%);
}

.guide-label.object-right-top {
  right: 4%;
  top: 17%;
}

.guide-label.object-left-top {
  left: 4%;
  top: 17%;
}

.guide-label.object-line-bottom {
  bottom: 11%;
  left: 9%;
}

.guide-label.object-edge-left {
  left: 2%;
  top: 16%;
}

.guide-label.object-edge-right {
  right: 2%;
  top: 16%;
}

.guide-label.object-window-right {
  right: 2%;
  top: 15%;
}

.guide-label.object-window-left {
  left: 2%;
  top: 15%;
}

.guide-label.object-table-bottom {
  bottom: 3%;
  left: 24%;
}

.guide-label.object-center {
  left: 50%;
  top: 37%;
  transform: translateX(-50%);
}

.horizon-indicator {
  background: rgba(0, 0, 0, .58);
  border: 2rpx solid rgba(255, 255, 255, .6);
  border-radius: 999rpx;
  color: #fff;
  font-size: 20rpx;
  left: 50%;
  padding: 8rpx 18rpx;
  position: absolute;
  top: 170rpx;
  transform: translateX(-50%);
  white-space: nowrap;
  z-index: 2;
}

.horizon-left,
.horizon-right {
  border-color: #e6b86a;
  color: #ffe1a5;
}

.camera-top-bar {
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  left: 0;
  padding: 16rpx 18rpx;
  position: absolute;
  top: 0;
  width: 100%;
  z-index: 4;
}

.camera-top-button {
  background: rgba(0, 0, 0, .5);
  border-radius: 999rpx;
  color: #fff;
  font-size: 22rpx;
  height: 62rpx;
  line-height: 62rpx;
  margin-right: 8rpx;
  padding: 0 16rpx;
  white-space: nowrap;
}

.switch-button {
  margin-right: 0;
}

.camera-info {
  color: #fff;
  padding: 22rpx 32rpx 8rpx;
}

.camera-step-row {
  align-items: center;
  display: flex;
  justify-content: space-between;
}

.camera-step-count {
  color: #cfc6bc;
  font-size: 24rpx;
}

.step-nav {
  display: flex;
}

.step-button {
  background: #2d2925;
  border-radius: 999rpx;
  color: #e8e0d7;
  font-size: 22rpx;
  line-height: 1.4;
  padding: 8rpx 20rpx;
}

.step-button-next {
  margin-left: 10rpx;
}

.step-button-disabled {
  opacity: .35;
}

.camera-step-text {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.5;
  margin-top: 12rpx;
  min-height: 96rpx;
}

.camera-sub-guide {
  color: #a69d95;
  font-size: 22rpx;
  line-height: 1.5;
  margin-top: 6rpx;
}

.camera-controls {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-top: auto;
  padding: 8rpx 40rpx calc(28rpx + env(safe-area-inset-bottom));
}

.control-text {
  background: transparent;
  color: #cfc6bc;
  font-size: 24rpx;
  line-height: 1.4;
  margin: 0;
  padding: 0;
  text-align: left;
  width: 180rpx;
}

.control-placeholder {
  width: 180rpx;
}

.shutter {
  align-items: center;
  background: #fff;
  border: 7rpx solid #aa9f94;
  border-radius: 50%;
  display: flex;
  height: 118rpx;
  justify-content: center;
  margin: 0;
  padding: 0;
  width: 118rpx;
}

.shutter-disabled {
  opacity: .5;
}

.shutter-inner {
  background: #fff;
  border: 3rpx solid #282421;
  border-radius: 50%;
  height: 87rpx;
  width: 87rpx;
}

.result-page {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
}

.result-head {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.result-title {
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
}

.result-ratio {
  background: #2d2925;
  border-radius: 999rpx;
  color: #d8cec3;
  font-size: 22rpx;
  padding: 8rpx 18rpx;
}

.result-image {
  background: #000;
  border-radius: 20rpx;
  height: 52vh;
  width: 100%;
}

.result-note {
  color: #b9afa5;
  font-size: 23rpx;
  line-height: 1.5;
  margin-top: 16rpx;
}

.result-actions {
  display: flex;
  margin-left: -6rpx;
  margin-right: -6rpx;
  margin-top: auto;
  padding-top: 24rpx;
}

.result-button {
  flex: 1;
  font-size: 23rpx;
  height: 82rpx;
  line-height: 80rpx;
  margin: 0 6rpx;
  padding: 0;
}

.button-disabled {
  opacity: .6;
}

.error-bar {
  align-items: center;
  background: #7d3f3a;
  bottom: 0;
  box-sizing: border-box;
  color: #fff;
  display: flex;
  font-size: 23rpx;
  left: 0;
  line-height: 1.45;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  position: fixed;
  right: 0;
  z-index: 30;
}

.error-text {
  flex: 1;
}

.error-close {
  flex: 0 0 auto;
  font-size: 34rpx;
  line-height: 1;
  padding: 10rpx 4rpx 10rpx 24rpx;
}

.crop-canvas {
  height: 1px;
  left: -9999px;
  position: fixed;
  top: 0;
  width: 1px;
}
