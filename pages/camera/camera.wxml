<view class="camera-page">
  <view wx:if="{{!template}}" class="camera-missing">{{labels.missing}}</view>

  <block wx:if="{{template}}">
    <view wx:if="{{!photoPath && cameraVisible}}" class="camera-stage" style="width:{{cameraWidth}}px;height:{{cameraHeight}}px">
      <camera class="camera" device-position="{{devicePosition}}" flash="off" binderror="cameraError">
        <cover-view wx:if="{{guideVisible}}" class="guide-overlay">
          <cover-view class="guide-safe-area"></cover-view>
          <cover-view wx:if="{{gridVisible}}" class="guide-grid">
            <cover-view class="guide-grid-v guide-grid-v1"></cover-view>
            <cover-view class="guide-grid-v guide-grid-v2"></cover-view>
            <cover-view class="guide-grid-h guide-grid-h1"></cover-view>
            <cover-view class="guide-grid-h guide-grid-h2"></cover-view>
          </cover-view>
          <cover-view class="guide-caption">{{template.title}}</cover-view>
          <cover-view class="guide-person {{personGuideClass}}"></cover-view>
          <cover-view class="guide-label person-label {{personGuideClass}}">{{personGuideLabel}}</cover-view>
          <cover-view class="guide-object {{objectGuideClass}}"></cover-view>
          <cover-view class="guide-label object-label {{objectGuideClass}}">{{objectGuideLabel}}</cover-view>
        </cover-view>

        <cover-view class="horizon-indicator horizon-{{horizonState}}">{{horizonText}}</cover-view>

        <cover-view class="camera-top-bar">
          <cover-view class="camera-top-button" bindtap="toggleGuide">{{guideVisible ? labels.hideGuide : labels.showGuide}}</cover-view>
          <cover-view class="camera-top-button" bindtap="toggleGrid">{{gridVisible ? labels.hideGrid : labels.showGrid}}</cover-view>
          <cover-view class="camera-top-button switch-button" bindtap="switchCamera">{{labels.switchCamera}}</cover-view>
        </cover-view>
      </camera>
    </view>

    <view wx:if="{{!photoPath}}" class="camera-info">
      <view class="camera-step-row">
        <text class="camera-step-count">{{labels.step}} {{guideStep + 1}} / {{template.steps.length}}</text>
        <view class="step-nav">
          <view class="step-button {{guideStep === 0 ? 'step-button-disabled' : ''}}" bindtap="prevStep">{{labels.previous}}</view>
          <view class="step-button step-button-next {{guideStep === template.steps.length - 1 ? 'step-button-disabled' : ''}}" bindtap="nextStep">{{labels.next}}</view>
        </view>
      </view>
      <view class="camera-step-text">{{template.steps[guideStep]}}</view>
      <view class="camera-sub-guide">{{labels.photographer}}：{{template.cameraGuide}} · {{labels.ratio}} {{targetRatio}}</view>
    </view>

    <view wx:if="{{!photoPath}}" class="camera-controls">
      <button class="control-text" bindtap="mirrorGuide">{{guideMirrored ? labels.flipBack : labels.flip}}</button>
      <button class="shutter {{isTaking ? 'shutter-disabled' : ''}}" bindtap="takePhoto" disabled="{{isTaking}}">
        <view class="shutter-inner"></view>
      </button>
      <view class="control-placeholder"></view>
    </view>

    <view wx:if="{{photoPath}}" class="result-page">
      <view class="result-head">
        <view class="result-title">{{saved ? labels.saved : labels.preview}}</view>
        <view class="result-ratio">{{targetRatio}}</view>
      </view>
      <image class="result-image" mode="aspectFit" src="{{photoPath}}"></image>
      <view class="result-note">{{labels.resultNote}}</view>
      <view class="result-actions">
        <button class="secondary-button result-button {{saving ? 'button-disabled' : ''}}" bindtap="retake" disabled="{{saving}}">{{labels.retake}}</button>
        <button class="secondary-button result-button {{saving ? 'button-disabled' : ''}}" bindtap="openEditor" disabled="{{saving}}">{{labels.edit}}</button>
        <button class="primary-button result-button {{saving ? 'button-disabled' : ''}}" bindtap="savePhoto" disabled="{{saving}}">{{saving ? labels.saving : (saved ? labels.saveAgain : labels.save)}}</button>
      </view>
    </view>

    <view wx:if="{{errorMessage}}" class="error-bar" bindtap="handleErrorTap">
      <text class="error-text">{{errorMessage}}</text>
      <text class="error-close" catchtap="dismissError">×</text>
    </view>
  </block>

  <canvas type="2d" id="cropCanvas" class="crop-canvas"></canvas>
</view>
